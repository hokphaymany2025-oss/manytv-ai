# Host/port where a locally running ComfyUI instance is listening.
# Start it first with scripts/run_comfyui.ps1 (see README.md).
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# Identifies this backend to ComfyUI's WebSocket API. Only matters if you
# run multiple orchestrators against the same ComfyUI instance.
COMFYUI_CLIENT_ID=manytv-backend

# Where generated images/video get downloaded to after ComfyUI finishes.
OUTPUT_DIR=output

# Directory of ComfyUI workflow JSON files exported in "API format".
WORKFLOW_DIR=backend/workflows

# SQLite file backing persistent job/shot state (backend/core/job_store.py)
# -- what makes job history and interrupted storyboard jobs survive a
# backend restart (backend/core/recovery.py). Lives under OUTPUT_DIR by
# default; safe to move, the file is created on first run if missing.
DB_PATH=output/jobs.db

# Safety limits (see "Anti-OOM safeguards" in README.md).
GENERATION_TIMEOUT_SECONDS=600
MAX_SHOTS_PER_JOB=50

# Age (days) past which a terminal (done/failed/cancelled) job's DB rows
# and output/<job_id>/ files are pruned at backend startup. 0 (default)
# disables pruning -- this permanently deletes job history and generated
# files, so it's opt-in. queued/running/resuming/cancelling jobs are never
# eligible regardless of age. Example: JOB_RETENTION_DAYS=30
JOB_RETENTION_DAYS=0

# Comma-separated origins allowed to make cross-origin browser requests
# (CORS). Empty by default -- no frontend exists yet, so there's no
# legitimate cross-origin caller, and this keeps any other page in the
# user's browser from being able to reach this API (see BUG-3, TODO.md).
# Set this once a real frontend exists, e.g. for a local Vite dev server:
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# OpenAI-compatible endpoint for /api/generate-script. Defaults to a local
# Ollama instance's OpenAI-compat shim -- `ollama pull <model>` first, and
# make sure LLM_MODEL below matches a model you've actually pulled (check
# with `ollama list`). To use a hosted provider instead, just change these
# three values (e.g. LLM_BASE_URL=https://api.openai.com/v1); no code
# changes needed.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b
# qwen3 "thinks" before answering by default (observed 30s-3min per call,
# even with think:false -- Ollama 0.32.0 doesn't honor it for this model).
# Bumped from a naive 120s default because that was silently triggering an
# SDK-level retry mid-generation. Pull a non-reasoning instruct model
# instead if you'd rather trade quality for speed.
LLM_TIMEOUT_SECONDS=300
